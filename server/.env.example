# ============================================================
#  PostComposer — Server Environment Variables
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to git.
# ============================================================

# ── Twitter / X ──────────────────────────────────────────────
# Get from: https://developer.twitter.com → Your App → Keys and Tokens
# Required OAuth 2.0 scopes: tweet.read tweet.write users.read offline.access
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
TWITTER_CALLBACK_URL=http://localhost:3001/auth/twitter/callback

# ── LinkedIn ──────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/ → Your App → Auth
# Required scopes: r_liteprofile r_emailaddress w_member_social
# NOTE: w_member_social requires LinkedIn Marketing Developer Platform approval.
# Apply at: https://www.linkedin.com/developers/apps → Products → Share on LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/linkedin/callback

# ── Facebook ──────────────────────────────────────────────────
# Get from: https://developers.facebook.com → Your App → Settings → Basic
# Required permissions: pages_show_list pages_read_engagement pages_manage_posts
# NOTE: pages_manage_posts requires Facebook App Review for production.
# For testing, add yourself as a test user in Roles → Test Users.
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# ── Server Settings ───────────────────────────────────────────
# Generate a strong random string for SESSION_SECRET
# Run this in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ── Frontend URL ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Server Port ───────────────────────────────────────────────
PORT=3001
